FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    sqlite3 \
    python3-dev \
    libopenblas-dev \
    libomp-dev \
    bubblewrap \
    libpq-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    numpy \
    faiss-cpu \
    chardet \
    pypdf \
    psycopg2-binary

RUN pip install --no-cache-dir \
    opentelemetry-api==1.21.0 \
    opentelemetry-sdk==1.21.0 \
    opentelemetry-instrumentation-fastapi==0.42b0 \
    opentelemetry-exporter-otlp==1.21.0 \
    opentelemetry-exporter-otlp-proto-http==1.21.0 \
    opentelemetry-instrumentation==0.42b0 \
    opentelemetry-semantic-conventions==0.42b0 \
    opentelemetry-util-http==0.42b0 \
    protobuf>=3.19.0

RUN pip install --no-cache-dir \
    llama-stack \
    fastapi \
    uvicorn \
    torch \
    transformers \
    sentence-transformers \
    python-multipart \
    pydantic \
    tenacity \
    requests \
    aiosqlite \
    sqlalchemy \
    databases[sqlite] \
    ollama \
    beautifulsoup4 \
    markdown \
    python-magic \
    spacy \
    scipy \
    scikit-learn \
    pandas \
    nltk \
    pytest \
    pytest-asyncio \
    tiktoken \
    chromadb \
    docx2txt \
    unstructured \
    python-pptx \
    openpyxl

RUN mkdir -p /root/.llama/distributions/ollama

RUN echo '{\
    "service_name": "llama-stack",\
    "service_version": "1.0.0",\
    "deployment_environment": "development"\
    }' > /app/telemetry_config.json

COPY run.yaml /app/run.yaml

ENV PYTHONUNBUFFERED=1
ENV OTEL_PYTHON_DISABLED=false
ENV OTEL_SERVICE_NAME=llama-stack
ENV PORT=8000

CMD ["sh", "-c", "python -m llama_stack.distribution.server.server --yaml-config /app/run.yaml --port ${PORT}"]